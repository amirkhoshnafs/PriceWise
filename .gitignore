# Python bytecode / tests / packaging
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

# Environments and local config
.venv/
venv/
env/
.env
.env.*
!.env.example
.streamlit/secrets.toml

# Jupyter and OS files
.ipynb_checkpoints/
.DS_Store
Thumbs.db

# Data: don't publish historical datasets without redistribution rights
data/raw/
data/processed/*
data/interim/
data/external/
!data/processed/.gitkeep
*.zip

# Temporary model artifacts (keep pricewise_rf.onnx and pricewise_policy.json if distributable)
models/*.candidate.onnx

# Temporary files
*.log
.tmp/
